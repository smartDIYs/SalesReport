# EC-CUBE 4 設定
# サイトのベースURL（末尾スラッシュなし）
ECCUBE_BASE_URL=https://your-eccube-shop.com
# OAuth2エンドポイント（API管理画面に表示されるURL）
ECCUBE_AUTHORIZE_URL=https://your-eccube-shop.com/{管理パス}/authorize
ECCUBE_TOKEN_URL=https://your-eccube-shop.com/token
ECCUBE_CLIENT_ID=your-client-id
ECCUBE_CLIENT_SECRET=your-client-secret

# サーバー設定
PORT=3001
# 本番環境のアプリURL（OAuth2コールバック・リダイレクト先）
# BASE_URL=https://your-app.onrender.com

# ベーシック認証（両方設定すると有効になる）
# BASIC_AUTH_USER=username
# BASIC_AUTH_PASS=password
